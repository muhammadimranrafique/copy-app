# Sanitized example. Copy to `.env` for local development.
# This file contains NO secrets and IS safe to commit.
#
# IMPORTANT:
# - VITE_* variables are baked into the production bundle at build time.
#   Never put credentials or secrets in VITE_* variables.
# - On Vercel, set VITE_API_BASE_URL in the project dashboard
#   (Settings -> Environment Variables) for the Production environment.
# - Production builds fail fast if VITE_API_BASE_URL is missing.
#
# Replace the placeholder below with the real API origin once the backend
# domain is selected (must be https:// and include the /api/v1 path):
VITE_API_BASE_URL=https://api.example.com/api/v1

# Mock mode. Must be false in production (enforced in production builds).
VITE_USE_MOCK=false

# Verbose API request/response logging. Must be false in production.
VITE_DEBUG=false
