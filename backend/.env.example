# ---------------------------------------------------------------------------
# Sanitized example. Copy to `.env` and fill in real values.
# NEVER commit the real .env file - it is excluded by .gitignore.
# ---------------------------------------------------------------------------

# Database Configuration (existing Neon PostgreSQL - keep unchanged)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Configuration
# Generate a strong secret with: openssl rand -hex 32
# Required in production (min 32 chars). The documented placeholder value
# is rejected when ENVIRONMENT=production.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
# development (default) | production
# production enforces: https-only explicit CORS origins, no localhost origins,
# required SECRET_KEY, disabled /docs, disabled public registration.
ENVIRONMENT=development
DEBUG=False

# CORS: comma-separated list of exact frontend origins (no trailing slash,
# no wildcard). Example for production:
# ALLOWED_ORIGINS=https://copy-app.vercel.app,https://app.yourdomain.com
# In development, localhost origins are added automatically.
ALLOWED_ORIGINS=

# SQLAlchemy SQL logging. Keep false in production (logs all SQL statements,
# including customer and payment data).
DB_ECHO=False

# Public self-registration. In production this defaults to false; set true
# only if open sign-up is genuinely required.
# ALLOW_PUBLIC_REGISTRATION=false

# Google Sheets (Optional, currently unused by the routers)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_ID=

# Redis (Optional, currently unused - no Celery workers are configured)
REDIS_URL=redis://localhost:6379/0

# Company Information
COMPANY_NAME=School Copy Manufacturing
COMPANY_ADDRESS=123 Business Street, Karachi, Pakistan
COMPANY_PHONE=+92 300 1234567
COMPANY_EMAIL=info@schoolcopy.com

# File Storage
# Invoice PDFs are written here; payment receipts are written to a sibling
# "receipts" directory. On a VPS use a persistent path such as:
# INVOICE_DIR=/opt/schoolcopy/data/invoices
INVOICE_DIR=./invoices
MAX_UPLOAD_SIZE=10485760
